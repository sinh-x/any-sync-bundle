# Production Environment Configuration
# Copy this file to .env and fill in your values
#
# cp .env.example .env
# nano .env

# =============================================================================
# DOMAIN CONFIGURATION
# =============================================================================

# Your domain name pointing to this server
# Must have an A record in DNS pointing to this server's public IP
DOMAIN=sync.yourdomain.com

# Email for Let's Encrypt certificate notifications
ACME_EMAIL=your-email@example.com

# =============================================================================
# WASABI S3 STORAGE
# =============================================================================

# Wasabi bucket name (create bucket first in Wasabi console)
S3_BUCKET=your-anysync-bucket

# Wasabi endpoint for your region
# Common regions:
#   US East 1:    https://s3.us-east-1.wasabisys.com
#   US East 2:    https://s3.us-east-2.wasabisys.com
#   US West 1:    https://s3.us-west-1.wasabisys.com
#   EU Central 1: https://s3.eu-central-1.wasabisys.com
#   EU Central 2: https://s3.eu-central-2.wasabisys.com
#   AP Northeast 1 (Tokyo): https://s3.ap-northeast-1.wasabisys.com
S3_ENDPOINT=https://s3.us-east-1.wasabisys.com

# Wasabi region (must match endpoint)
S3_REGION=us-east-1

# Wasabi access credentials (from Wasabi console > Access Keys)
S3_ACCESS_KEY=your-wasabi-access-key
S3_SECRET_KEY=your-wasabi-secret-key
